# =============================================================================
# Sou'Sou backend — environnement de développement
# Copier ce fichier vers `backend/.env` et remplir les valeurs.
# =============================================================================

# --- Serveur ---
PORT=4100
NODE_ENV=development
FRONTEND_URL=http://localhost:3100

# --- Base de données (Postgres lancé via docker-compose) ---
DATABASE_URL="postgresql://sousou:sousou_dev_password@localhost:5532/sousou?schema=public"

# --- JWT ---
# Régénère ces secrets en prod : `openssl rand -hex 64`
JWT_ACCESS_SECRET=change_me_dev_access_secret_at_least_32_chars_long_xxx
JWT_REFRESH_SECRET=change_me_dev_refresh_secret_at_least_32_chars_long_xxx
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- Cookies ---
# En dev local (http://localhost) : COOKIE_SECURE=false, COOKIE_SAMESITE=lax
# En prod cross-origin (Vercel↔Render) : COOKIE_SECURE=true, COOKIE_SAMESITE=none
# `sameSite=none` requiert obligatoirement `secure=true` côté navigateur.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=localhost

# --- Email (Brevo) ---
# Génère une nouvelle clé sur https://app.brevo.com/settings/keys/api
BREVO_API_KEY=
BREVO_SENDER_EMAIL=charbelnoukon@gmail.com
BREVO_SENDER_NAME="Sou'Sou"

# --- Storage des avatars uploadés (Cloudinary) ---
# Si défini : les uploads sont envoyés à Cloudinary (recommandé en prod).
# Si absent : fallback sur le filesystem local backend/uploads/avatars/ (dev OK,
#   PAS en prod sur Render/Fly/Railway/... où le disque est éphémère).
# Format : `cloudinary://<api_key>:<api_secret>@<cloud_name>`
# Récupérer la valeur sur https://console.cloudinary.com/console (Dashboard → API Environment variable)
CLOUDINARY_URL=
